{
  "name": "lightmap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "firebase": "firebase",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only database \"node tests/rules.emulator.mjs\"",
    "lint:functions": "npm --prefix functions run lint",
    "test:functions": "npm --prefix functions test",
    "check": "node --check public/main.js && npm test && npm run lint:functions && npm run test:functions"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "firebase-tools": "15.28.2"
  }
}
